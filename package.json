{
  "name": "becoming-the-man",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "react-router dev",
    "lint": "eslint .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "build": "react-router build",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:change-size": "bash scripts/check-change-size.sh"
  },
  "dependencies": {
    "@react-router/node": "7.18.2",
    "@vercel/react-router": "1.3.4",
    "isbot": "^5.1.31",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@react-router/dev": "7.18.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
