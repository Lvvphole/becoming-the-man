{
  "name": "becoming-the-man",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "lint": "eslint .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "test:contracts": "vitest run tests/contracts tests/unit",
    "test:rls": "vitest run supabase/tests",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test tests/a11y",
    "verify:seo": "playwright test tests/seo",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "verify:agents": "node scripts/verify-agents.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run verify:boundaries && npm run verify:agents",
    "verify:release": "npm run verify && npm run test:e2e && npm run test:a11y && npm run verify:seo"
  },
  "dependencies": {
    "@vercel/react-router": "^1.3.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@react-router/dev": "7.18.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@eslint/js": "^9.0.0",
    "cross-env": "^10.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
