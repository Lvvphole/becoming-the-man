{
  "version": "2.0.0",
  "task_envelope": {
    "required_fields": [
      "task_domains",
      "source_sections",
      "workpiece_paths",
      "selected_evidence_ids",
      "authorized_candidate_paths",
      "approvals",
      "source_binding"
    ],
    "path_array_fields": [
      "workpiece_paths",
      "authorized_candidate_paths"
    ],
    "repo_path_pattern": "^(?![/])[A-Za-z0-9._/-]+$",
    "forbid_parent_traversal": true
  },
  "blocked_record": {
    "required_fields": [
      "status",
      "reason_code",
      "gate_id",
      "route_candidates",
      "missing_inputs",
      "conflicts",
      "source_binding",
      "resolution_required"
    ],
    "source_binding_required_fields": ["base", "current_head"],
    "source_binding_optional_fields": ["pr"],
    "status": "BLOCKED",
    "reason_codes": [
      "ROUTING_TABLE_INVALID",
      "ROUTE_ZERO_MATCH",
      "ROUTE_MULTI_MATCH",
      "MISSING_SELECTOR",
      "MISSING_SOURCE",
      "SOURCE_BINDING_STALE",
      "WILDCARD_INPUT",
      "EVIDENCE_INDEX_MISSING",
      "EVIDENCE_ID_UNKNOWN",
      "EVIDENCE_BINDING_STALE",
      "EVIDENCE_AUTHORITY_FORBIDDEN",
      "UNLISTED_INPUT",
      "REVIEW_CYCLE_EXCEEDED",
      "CHANGE_SIZE_DRIFT",
      "TASK_ENVELOPE_REQUIRED",
      "CONTRACT_INCOMPLETE",
      "CONTRACT_SCOPE_EXPANSION",
      "VERIFIER_UNDEFINED"
    ]
  },
  "architecture": {
    "active_sources": [
      "docs/Website_System_Architecture_v1.0_LOCKED.md",
      "docs/SYSTEM_ARCHITECTURE_AMENDMENT_v1.1.md",
      "docs/SYSTEM_ARCHITECTURE_AMENDMENT_v1.2.md"
    ]
  },
  "governance": {
    "active_reviewable_loc_limit": 500,
    "active_500_paths": [
      "AGENTS.md",
      "references/architecture/CONTEXT.md",
      "references/engineering/engineering-rules.md",
      "docs/Website_System_Architecture_v1.0_LOCKED.md",
      "docs/SYSTEM_ARCHITECTURE_AMENDMENT_v1.1.md",
      "docs/SYSTEM_ARCHITECTURE_AMENDMENT_v1.2.md",
      "scripts/check-change-size.sh"
    ]
  }
}
