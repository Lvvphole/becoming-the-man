{
  "version": "2.0.0",
  "authority": "CONTEXT.md",
  "purpose": "Machine-checkable invariants for deterministic repository path routing. CONTEXT.md remains the sole route table.",
  "input_contract": {
    "required": [
      "affected_paths"
    ],
    "affected_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "task_domain": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional explicit disambiguator only; never inferred from semantic similarity."
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "invariants": {
    "exact_path_resolution": true,
    "unknown_path": "BLOCKED: ROUTE_NOT_FOUND",
    "ambiguous_path": "BLOCKED: ROUTE_AMBIGUOUS",
    "multi_path_composition": "UNION_REQUIREMENTS",
    "semantic_similarity_routing": false,
    "evidence_is_authority": false,
    "external_harness_is_authority": false,
    "external_harness_grants_merge": false,
    "merge_requires_separate_owner_authorization": true
  },
  "output_contract": {
    "required": [
      "resolved_paths",
      "required_sources",
      "required_verification",
      "stop_conditions"
    ],
    "resolved_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "authority_boundary": {
    "canonical_route_table": "CONTEXT.md",
    "engineering_rules": "references/engineering/engineering-rules.md",
    "evidence_prefix": "docs/evidence/",
    "evidence_role": "non-authoritative observed-state evidence only"
  }
}
